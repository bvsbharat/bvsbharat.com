---
import "@/styles/global.css";
import { SITE } from "@/config";
import { ClientRouter, fade } from "astro:transitions";
import JsonLD from "@/components/JsonLD.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** Emit schema.org ProfilePage (About page). */
  profilePage?: boolean;
  /** Set automatically when this layout wraps an .md/.mdx page. */
  frontmatter?: {
    title?: string;
    description?: string;
    ogImage?: string;
    profilePage?: boolean;
  };
  article?: {
    title: string;
    description: string;
    pubDatetime: Date;
    modDatetime?: Date | null;
    heroImage?: string;
    url: string;
    tags?: string[];
  };
}

// MDX pages (e.g. about.mdx) pass their frontmatter instead of props.
const fm = Astro.props.frontmatter ?? {};
const {
  title = fm.title ?? SITE.title,
  description = fm.description ?? SITE.desc,
  ogImage = fm.ogImage ?? SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  profilePage = fm.profilePage ?? false,
  article,
} = Astro.props;

// Social cards need a raster image: SVG and YouTube URLs fall back to the default card.
const requestedOg = ogImage ?? SITE.ogImage;
const ogUsable = !requestedOg.toLowerCase().endsWith(".svg") && !requestedOg.includes("youtube.com");
const resolvedOg = ogUsable ? requestedOg : SITE.ogImage;
const isDefaultOgImage = resolvedOg === SITE.ogImage;
const socialImageURL = new URL(resolvedOg, Astro.site).href;
// Don't append the site name when the title already contains it.
const pageTitle = title.includes(SITE.title) ? title : `${title} | ${SITE.title}`;
---

<!doctype html>
<html lang="en" class={scrollSmooth ? "scroll-smooth" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- KaTeX math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UCUCR7tHJYYCtyBOUN5CEXEY3dbxFRSZ1MQEE8zwTVEyCKnB8QL" crossorigin="anonymous" />

    <!-- Google Fonts — Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap" rel="stylesheet" />

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TTV16ZS899"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-TTV16ZS899');
    </script>

    <!-- General Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="google-site-verification" content="f8UoTSiaZuyz5H8PMQi_XFVZSxj5cZA0gk-uGCJ17sQ" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    {isDefaultOgImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${SITE.author}, ${SITE.jobTitle}`} />
      </>
    )}
    <meta property="og:type" content={article ? "article" : profilePage ? "profile" : "website"} />
    {profilePage && (
      <>
        <meta property="profile:first_name" content={SITE.author.split(" ")[0]} />
        <meta property="profile:last_name" content={SITE.author.split(" ").slice(1).join(" ")} />
        <meta property="profile:username" content="bvsbharat" />
      </>
    )}
    {article && <meta property="article:author" content={SITE.profile} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    {pubDatetime && (
      <meta
        property="article:published_time"
        content={pubDatetime.toISOString()}
      />
    )}
    {modDatetime && (
      <meta
        property="article:modified_time"
        content={modDatetime.toISOString()}
      />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:creator" content={SITE.twitterHandle} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Theme (must run inline before paint to avoid flash) -->
    <script is:inline>
      (function() {
        function getTheme() {
          if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
            return localStorage.getItem("theme");
          }
          return "light";
        }
        function setTheme() {
          var theme = getTheme();
          document.documentElement.setAttribute("data-theme", theme);
        }
        setTheme();
        document.addEventListener("astro:after-swap", setTheme);
        // Scroll to top on page navigation
        document.addEventListener("astro:after-swap", function() {
          window.scrollTo({ left: 0, top: 0, behavior: "instant" });
        });
      })();
    </script>

    <!-- Pagefind -->
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>

    <!-- Structured Data -->
    <JsonLD
      pageUrl={canonicalURL}
      pageTitle={pageTitle}
      pageDescription={description}
      profilePage={profilePage}
      article={article}
    />
  </head>
  <body transition:animate={fade({ duration: '0.3s' })}>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />
  </body>
</html>
